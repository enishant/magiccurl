{
    "name": "enishant/magiccurl",
    "type": "library",
    "description": "A lightweight, dependency-free HTTP client built on the PHP cURL extension.",
    "homepage": "https://github.com/enishant/magiccurl",
    "license": "MIT",
    "authors": [
        {
            "name": "Nishant Vaity",
            "email": "enishant@gmail.com",
            "homepage": "https://www.nishantvaity.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Enishant\\MagicCurl\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Enishant\\MagicCurl\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "find src tests -name '*.php' -exec php -l {} \\;"
    },
    "keywords": ["magiccurl", "curl", "http client", "request", "requests", "get request", "post request", "response", "responses"],
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
